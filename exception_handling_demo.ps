// Exception Handling Examples - PowerScript
class DatabaseConnection {
    private isConnected: boolean = false;
    
    constructor(connectionString: string) {
        if (!connectionString) {
            throw new Error("Connection string cannot be empty");
        }
        this.connect(connectionString);
    }
    
    private connect(connectionString: string): void {
        try {
            // Simulate connection logic
            if (connectionString === "invalid") {
                throw new RuntimeError("Invalid connection string");
            }
            this.isConnected = true;
            print("Connected to database");
        } catch (error: RuntimeError) {
            print("Runtime error: " + error.message);
            throw error; // Re-throw
        } catch (error) {
            print("Unknown error: " + error);
            this.isConnected = false;
        } finally {
            print("Connection attempt completed");
        }
    }
    
    public async query(sql: string): Promise<Array<any>> {
        if (!this.isConnected) {
            throw new Error("Not connected to database");
        }
        
        try {
            // Simulate async database query
            let result = await this.executeQuery(sql);
            return result;
        } catch (error: TypeError) {
            print("Type error in query: " + error.message);
            return [];
        } catch (error: ValueError) {
            print("Value error: " + error.message);
            return [];
        } finally {
            print("Query execution finished");
        }
    }
    
    private async executeQuery(sql: string): Promise<Array<any>> {
        if (!sql || sql.trim() === "") {
            throw new ValueError("SQL query cannot be empty");
        }
        
        // Simulate query execution
        return [{"id": 1, "name": "test"}];
    }
}

// Usage with comprehensive error handling
async function demonstrateErrorHandling(): Promise<void> {
    let db: DatabaseConnection;
    
    try {
        // Test constructor exception
        db = new DatabaseConnection("valid_connection");
        
        // Test method exceptions
        let results = await db.query("SELECT * FROM users");
        print("Query results: " + results.length);
        
        // Test empty query exception
        let emptyResults = await db.query("");
        
    } catch (error: Error) {
        print("Application error: " + error.message);
    } catch (error) {
        print("Unexpected error: " + error);
    } finally {
        print("Error handling demonstration completed");
    }
}

// Exception hierarchy
class CustomError extends Error {
    constructor(message: string, code: number) {
        super(message);
        this.code = code;
    }
    
    public code: number;
}

class ValidationError extends CustomError {
    constructor(field: string, value: any) {
        super(`Validation failed for field '${field}' with value '${value}'`, 400);
        this.field = field;
        this.value = value;
    }
    
    public field: string;
    public value: any;
}

// Advanced error handling with custom exceptions
function validateUser(user: any): void {
    try {
        if (!user.name || user.name.trim() === "") {
            throw new ValidationError("name", user.name);
        }
        
        if (!user.email || !user.email.includes("@")) {
            throw new ValidationError("email", user.email);
        }
        
        if (user.age < 0 || user.age > 150) {
            throw new ValidationError("age", user.age);
        }
        
        print("User validation passed");
        
    } catch (error: ValidationError) {
        print(`Validation Error - ${error.field}: ${error.message}`);
        throw error; // Re-throw for caller to handle
    } catch (error: CustomError) {
        print(`Custom Error [${error.code}]: ${error.message}`);
        throw error;
    } catch (error) {
        print("Unexpected validation error: " + error);
        throw new Error("Validation failed due to unexpected error");
    }
}

// Main execution
async function main(): Promise<void> {
    try {
        await demonstrateErrorHandling();
        
        // Test custom exceptions
        let invalidUser = {name: "", email: "invalid", age: -5};
        validateUser(invalidUser);
        
    } catch (error) {
        print("Main execution error: " + error);
    }
}

main();