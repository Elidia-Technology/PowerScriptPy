// Object-Oriented Programming Example
// Demonstrates classes, inheritance, and access modifiers

// Base class with access modifiers
class Animal {
    protected name: string;
    private age: number;
    public species: string;
    
    constructor(name: string, species: string, age: number = 0) {
        this.name = name;
        this.species = species;
        this.age = age;
    }
    
    public function getName(): string {
        return this.name;
    }
    
    public function getAge(): number {
        return this.age;
    }
    
    protected function setAge(age: number): void {
        if (age >= 0) {
            this.age = age;
        }
    }
    
    public function makeSound(): string {
        return "Some generic animal sound";
    }
    
    public function introduce(): string {
        return `I am ${this.name}, a ${this.species}, ${this.age} years old.`;
    }
    
    private function validateAge(age: number): boolean {
        return age >= 0 && age <= 100;
    }
}

// Derived class
class Dog : Animal {
    private breed: string;
    
    constructor(name: string, breed: string, age: number = 0) {
        super(name, "Dog", age);
        this.breed = breed;
    }
    
    public function getBreed(): string {
        return this.breed;
    }
    
    // Override parent method
    public function makeSound(): string {
        return "Woof! Woof!";
    }
    
    public function wagTail(): string {
        return `${this.name} is wagging tail happily!`;
    }
    
    // Method using protected member from parent
    public function celebrate(): void {
        console.log(`${this.name} the ${this.breed} is celebrating!`);
        this.setAge(this.getAge() + 1); // Using protected method
    }
}

// Another derived class
class Cat : Animal {
    private indoor: boolean;
    
    constructor(name: string, age: number = 0, indoor: boolean = true) {
        super(name, "Cat", age);
        this.indoor = indoor;
    }
    
    public function makeSound(): string {
        return "Meow! Meow!";
    }
    
    public function isIndoor(): boolean {
        return this.indoor;
    }
    
    public function hunt(): string {
        if (this.indoor) {
            return `${this.name} is hunting toy mice indoors.`;
        } else {
            return `${this.name} is hunting real mice outdoors.`;
        }
    }
}

// Generic class example
class Container<T> {
    private items: Array<T>;
    
    constructor() {
        this.items = [];
    }
    
    public function add(item: T): void {
        this.items.push(item);
    }
    
    public function get(index: number): T? {
        if (index >= 0 && index < this.items.length) {
            return this.items[index];
        }
        return null;
    }
    
    public function size(): number {
        return this.items.length;
    }
    
    public function getAll(): Array<T> {
        return [...this.items]; // Spread operator for copying
    }
}

// Static class example
class MathUtils {
    public static function max(a: number, b: number): number {
        return a > b ? a : b;
    }
    
    public static function min(a: number, b: number): number {
        return a < b ? a : b;
    }
    
    public static function average(numbers: Array<number>): number {
        if (numbers.length === 0) return 0;
        
        let sum: number = 0;
        for (let num of numbers) {
            sum += num;
        }
        return sum / numbers.length;
    }
}

// Main function demonstrating usage
function main(): void {
    console.log("=== Animal Examples ===");
    
    // Create animals
    let dog: Dog = new Dog("Buddy", "Golden Retriever", 3);
    let cat: Cat = new Cat("Whiskers", 2, true);
    
    // Basic information
    console.log(dog.introduce());
    console.log(cat.introduce());
    
    // Sounds
    console.log(`Dog says: ${dog.makeSound()}`);
    console.log(`Cat says: ${cat.makeSound()}`);
    
    // Specific behaviors
    console.log(dog.wagTail());
    console.log(cat.hunt());
    
    // Access modifier demonstration
    console.log(`Dog's breed: ${dog.getBreed()}`);
    console.log(`Cat is indoor: ${cat.isIndoor()}`);
    
    // Method using protected access
    dog.celebrate();
    
    console.log("\n=== Generic Container Example ===");
    
    // Generic container with strings
    let stringContainer: Container<string> = new Container<string>();
    stringContainer.add("Hello");
    stringContainer.add("World");
    stringContainer.add("PowerScript");
    
    console.log(`Container size: ${stringContainer.size()}`);
    console.log(`First item: ${stringContainer.get(0) ?? "none"}`);
    console.log(`All items: ${stringContainer.getAll().join(", ")}`);
    
    // Generic container with numbers
    let numberContainer: Container<number> = new Container<number>();
    numberContainer.add(10);
    numberContainer.add(20);
    numberContainer.add(30);
    
    console.log(`Number container: ${numberContainer.getAll().join(", ")}`);
    
    console.log("\n=== Static Methods Example ===");
    
    let numbers: Array<number> = [5, 2, 8, 1, 9];
    console.log(`Numbers: ${numbers.join(", ")}`);
    console.log(`Max: ${MathUtils.max(5, 10)}`);
    console.log(`Min: ${MathUtils.min(5, 10)}`);
    console.log(`Average: ${MathUtils.average(numbers)}`);
}

main();