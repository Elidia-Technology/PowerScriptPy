// PowerScript Computer Vision Example
// Demonstrates CNN implementation and image processing

import { torch } from "torch";
import { torch.nn as nn } from "torch";
import { torch.nn.functional as F } from "torch";
import { torchvision } from "torchvision";
import { torchvision.transforms as transforms } from "torchvision";
import { PIL.Image as Image } from "PIL";
import { numpy as np } from "numpy";

// Convolutional Neural Network for Image Classification
class ConvNet extends nn.Module {
    private conv1: nn.Conv2d;
    private conv2: nn.Conv2d;
    private conv3: nn.Conv2d;
    private pool: nn.MaxPool2d;
    private dropout1: nn.Dropout2d;
    private dropout2: nn.Dropout;
    private fc1: nn.Linear;
    private fc2: nn.Linear;
    private fc3: nn.Linear;
    
    constructor(numClasses: number = 10) {
        super();
        
        // Convolutional layers
        this.conv1 = nn.Conv2d(3, 32, 3, { padding: 1 });
        this.conv2 = nn.Conv2d(32, 64, 3, { padding: 1 });
        this.conv3 = nn.Conv2d(64, 128, 3, { padding: 1 });
        
        // Pooling and dropout
        this.pool = nn.MaxPool2d(2, 2);
        this.dropout1 = nn.Dropout2d(0.25);
        this.dropout2 = nn.Dropout(0.5);
        
        // Fully connected layers
        this.fc1 = nn.Linear(128 * 4 * 4, 512);
        this.fc2 = nn.Linear(512, 256);
        this.fc3 = nn.Linear(256, numClasses);
    }
    
    forward(x: torch.Tensor): torch.Tensor {
        // First conv block
        x = this.pool(F.relu(this.conv1(x)));
        x = this.dropout1(x);
        
        // Second conv block
        x = this.pool(F.relu(this.conv2(x)));
        x = this.dropout1(x);
        
        // Third conv block
        x = this.pool(F.relu(this.conv3(x)));
        x = this.dropout1(x);
        
        // Flatten for fully connected layers
        x = x.view(-1, 128 * 4 * 4);
        
        // Fully connected layers
        x = F.relu(this.fc1(x));
        x = this.dropout2(x);
        x = F.relu(this.fc2(x));
        x = this.dropout2(x);
        x = this.fc3(x);
        
        return x;
    }
}

// Image Preprocessing Pipeline
class ImageProcessor {
    private transform: transforms.Compose;
    
    constructor(imageSize: number = 32) {
        this.transform = transforms.Compose([
            transforms.Resize((imageSize, imageSize)),
            transforms.ToTensor(),
            transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
        ]);
    }
    
    processImage(imagePath: string): torch.Tensor {
        const image = Image.open(imagePath);
        return this.transform(image).unsqueeze(0); // Add batch dimension
    }
    
    processBatch(imagePaths: string[]): torch.Tensor {
        const tensors = imagePaths.map(path => this.processImage(path).squeeze(0));
        return torch.stack(tensors);
    }
    
    augmentImage(image: torch.Tensor): torch.Tensor {
        // Random augmentations
        const augmentTransform = transforms.Compose([
            transforms.RandomHorizontalFlip(0.5),
            transforms.RandomRotation(10),
            transforms.ColorJitter(0.1, 0.1, 0.1, 0.1)
        ]);
        
        return augmentTransform(image);
    }
}

// Computer Vision Trainer
class CVTrainer {
    private model: ConvNet;
    private device: torch.device;
    private optimizer: torch.optim.Optimizer;
    private criterion: nn.Module;
    private processor: ImageProcessor;
    
    constructor(numClasses: number, learningRate: number = 0.001) {
        this.device = torch.cuda.is_available() ? torch.device("cuda") : torch.device("cpu");
        this.model = new ConvNet(numClasses).to(this.device);
        this.optimizer = torch.optim.Adam(this.model.parameters(), { lr: learningRate });
        this.criterion = nn.CrossEntropyLoss();
        this.processor = new ImageProcessor();
        
        console.log(`Using device: ${this.device}`);
        console.log(`Model parameters: ${this.countParameters()}`);
    }
    
    private countParameters(): number {
        return this.model.parameters()
            .filter(p => p.requires_grad)
            .reduce((total, p) => total + p.numel(), 0);
    }
    
    async trainBatch(images: torch.Tensor, labels: torch.Tensor): Promise<number> {
        this.model.train();
        
        images = images.to(this.device);
        labels = labels.to(this.device);
        
        // Forward pass
        this.optimizer.zero_grad();
        const outputs = this.model.forward(images);
        const loss = this.criterion(outputs, labels);
        
        // Backward pass
        loss.backward();
        this.optimizer.step();
        
        return loss.item();
    }
    
    async evaluateBatch(images: torch.Tensor, labels: torch.Tensor): Promise<{loss: number, accuracy: number}> {
        this.model.eval();
        
        images = images.to(this.device);
        labels = labels.to(this.device);
        
        const outputs = this.model.forward(images);
        const loss = this.criterion(outputs, labels);
        
        const predicted = torch.argmax(outputs, 1);
        const correct = (predicted === labels).sum().item();
        const accuracy = correct / labels.size(0);
        
        return { loss: loss.item(), accuracy };
    }
    
    async trainEpoch(dataLoader: any): Promise<{avgLoss: number, avgAccuracy: number}> {
        let totalLoss = 0;
        let totalAccuracy = 0;
        let numBatches = 0;
        
        for await (const [images, labels] of dataLoader) {
            const loss = await this.trainBatch(images, labels);
            const { accuracy } = await this.evaluateBatch(images, labels);
            
            totalLoss += loss;
            totalAccuracy += accuracy;
            numBatches++;
            
            // Progress update
            if (numBatches % 10 === 0) {
                console.log(`Batch ${numBatches}: Loss = ${loss:.4f}, Acc = ${accuracy:.4f}`);
            }
        }
        
        return {
            avgLoss: totalLoss / numBatches,
            avgAccuracy: totalAccuracy / numBatches
        };
    }
    
    async predict(imagePath: string): Promise<{prediction: number, confidence: number, probabilities: number[]}> {
        this.model.eval();
        
        const image = this.processor.processImage(imagePath).to(this.device);
        const outputs = this.model.forward(image);
        const probabilities = F.softmax(outputs, 1);
        
        const prediction = torch.argmax(probabilities, 1).item();
        const confidence = probabilities[0][prediction].item();
        const probArray = probabilities[0].cpu().numpy();
        
        return {
            prediction,
            confidence,
            probabilities: Array.from(probArray)
        };
    }
    
    saveModel(path: string): void {
        torch.save(this.model.state_dict(), path);
        console.log(`Model saved to ${path}`);
    }
    
    loadModel(path: string): void {
        this.model.load_state_dict(torch.load(path));
        console.log(`Model loaded from ${path}`);
    }
}

// Object Detection with YOLO-style approach
class ObjectDetector {
    private model: nn.Module;
    private anchors: number[][];
    private classNames: string[];
    
    constructor(classNames: string[]) {
        this.classNames = classNames;
        this.anchors = [
            [10, 13], [16, 30], [33, 23],
            [30, 61], [62, 45], [59, 119],
            [116, 90], [156, 198], [373, 326]
        ];
        this.buildModel();
    }
    
    private buildModel(): void {
        // Simplified YOLO-like architecture
        this.model = nn.Sequential(
            // Backbone
            nn.Conv2d(3, 32, 3, { padding: 1 }),
            nn.BatchNorm2d(32),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),
            
            nn.Conv2d(32, 64, 3, { padding: 1 }),
            nn.BatchNorm2d(64),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),
            
            nn.Conv2d(64, 128, 3, { padding: 1 }),
            nn.BatchNorm2d(128),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),
            
            // Detection head
            nn.Conv2d(128, 256, 3, { padding: 1 }),
            nn.ReLU(),
            nn.Conv2d(256, (5 + this.classNames.length) * 3, 1) // 3 anchors per cell
        );
    }
    
    forward(x: torch.Tensor): torch.Tensor {
        return this.model.forward(x);
    }
    
    async detectObjects(imagePath: string, confidenceThreshold: number = 0.5): Promise<any[]> {
        const processor = new ImageProcessor(416); // YOLO input size
        const image = processor.processImage(imagePath);
        
        const outputs = this.forward(image);
        const detections = this.postprocess(outputs, confidenceThreshold);
        
        return detections;
    }
    
    private postprocess(outputs: torch.Tensor, confidenceThreshold: number): any[] {
        // Simplified post-processing
        const detections = [];
        const [batchSize, channels, height, width] = outputs.shape;
        
        // This would typically involve NMS and proper bbox decoding
        // Simplified version for demonstration
        
        return detections;
    }
}

// Transfer Learning Example
class TransferLearningTrainer extends CVTrainer {
    constructor(numClasses: number, pretrainedModel: string = "resnet18") {
        super(numClasses);
        this.loadPretrainedModel(pretrainedModel);
    }
    
    private loadPretrainedModel(modelName: string): void {
        // Load pretrained model and modify final layer
        const pretrainedModel = torchvision.models[modelName](true); // pretrained=True
        
        // Freeze early layers
        for (const param of pretrainedModel.parameters()) {
            param.requires_grad = false;
        }
        
        // Replace final layer
        const numFeatures = pretrainedModel.fc.in_features;
        pretrainedModel.fc = nn.Linear(numFeatures, this.model.fc3.out_features);
        
        this.model = pretrainedModel.to(this.device);
        
        // Only train the final layer initially
        this.optimizer = torch.optim.Adam(this.model.fc.parameters(), { lr: 0.001 });
    }
    
    unfreezeAllLayers(): void {
        for (const param of this.model.parameters()) {
            param.requires_grad = true;
        }
        
        // Use smaller learning rate for fine-tuning
        this.optimizer = torch.optim.Adam(this.model.parameters(), { lr: 0.0001 });
        console.log("All layers unfrozen for fine-tuning");
    }
}

// Main Computer Vision Pipeline
async function main(): Promise<void> {
    console.log("Starting Computer Vision Pipeline...");
    
    // Image classification example
    const classNames = ["cat", "dog", "bird", "car", "plane"];
    const trainer = new CVTrainer(classNames.length);
    
    // Simulate training (in real scenario, you'd load actual data)
    console.log("Training CNN...");
    
    // Transfer learning example
    const transferTrainer = new TransferLearningTrainer(classNames.length);
    console.log("Using transfer learning with pretrained ResNet");
    
    // Object detection example
    const detector = new ObjectDetector(classNames);
    console.log("Object detector initialized");
    
    // Example prediction
    try {
        const result = await trainer.predict("test_image.jpg");
        console.log(`Prediction: ${classNames[result.prediction]} (${result.confidence:.2f})`);
    } catch (error) {
        console.log("Test image not found, skipping prediction demo");
    }
    
    console.log("Computer Vision pipeline completed!");
}

// Export classes for module use
export { ConvNet, ImageProcessor, CVTrainer, ObjectDetector, TransferLearningTrainer };

if (require.main === module) {
    main().catch(console.error);
}