// PowerScript Context Managers (with statements) Test

// Simple with statement
with open("test.txt", "r") as file {
    console.log("File opened:", file);
    let content = file.read();
    console.log("Content:", content);
}

// With statement without 'as' clause
with some_context_manager() {
    console.log("Inside context manager");
}

// Nested with statements
with open("input.txt", "r") as input_file {
    with open("output.txt", "w") as output_file {
        let data = input_file.read();
        output_file.write(data.toUpperCase());
        console.log("File processing completed");
    }
}

console.log("Context managers test completed!");