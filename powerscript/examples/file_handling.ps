// PowerScript File Handling Examples
// Demonstrates comprehensive file I/O operations

// =====================================================
// BASIC FILE OPERATIONS
// =====================================================

// Write text to a file
let content = "Hello, PowerScript! This is file handling example.";
file_write("example.txt", content);

// Read text from a file
let text = file_read("example.txt");
console.log("File content:", text);

// Check if file exists
if file_exists("example.txt") {
    console.log("File exists!")
} else {
    console.log("File does not exist!")
}

// Append to a file
file_append("example.txt", "\nThis is an appended line.")

// =====================================================
// FILE CLASS OPERATIONS
// =====================================================

// Create a File object
let file = File("data.txt")

// Write using File object
file.write("Line 1\nLine 2\nLine 3")

// Read all content
let all_content = file.read()
console.log("All content:", all_content)

// Read lines
let lines = file.read_lines()
for line in lines {
    console.log("Line:", line)
}

// File properties
console.log("File size:", file.size())
console.log("File exists:", file.exists())
console.log("Is file:", file.is_file())

// =====================================================
// DIRECTORY OPERATIONS
// =====================================================

// Create directories
dir_create("test_folder")
dir_create("nested/folder/structure")

// List directory contents
let contents = dir_list(".")
console.log("Current directory contents:", contents)

// Directory class operations
let directory = Directory("test_folder")
console.log("Directory exists:", directory.exists())
console.log("Is directory:", directory.is_dir())

// Create subdirectory
directory.create_subdir("subdir")

// List directory files
let files = directory.list_files()
console.log("Files in directory:", files)

// =====================================================
// PATH OPERATIONS
// =====================================================

// Path manipulation
let path = Path("folder/subfolder/file.txt")
console.log("Parent:", path.parent())
console.log("Name:", path.name())
console.log("Extension:", path.extension())
console.log("Stem:", path.stem())

// Join paths
let joined = path_join("home", "user", "documents", "file.txt")
console.log("Joined path:", joined)

// Absolute path
let absolute = path_absolute("./relative/path.txt")
console.log("Absolute path:", absolute)

// =====================================================
// JSON FILE OPERATIONS
// =====================================================

// Create JSON data
let data = {
    "name": "PowerScript",
    "version": "1.0",
    "features": ["file_handling", "json_support", "csv_support"],
    "config": {
        "debug": true,
        "max_files": 100
    }
}

// Write JSON
json_write("config.json", data)

// Read JSON
let loaded_data = json_read("config.json")
console.log("Loaded JSON:", loaded_data)

// =====================================================
// CSV FILE OPERATIONS
// =====================================================

// Create CSV data
let csv_data = [
    ["Name", "Age", "City"],
    ["Alice", "25", "New York"],
    ["Bob", "30", "Los Angeles"],
    ["Charlie", "35", "Chicago"]
]

// Write CSV
csv_write("people.csv", csv_data)

// Read CSV
let loaded_csv = csv_read("people.csv")
console.log("Loaded CSV:", loaded_csv)

// CSV with custom delimiter
csv_write("data.tsv", csv_data, "\t")  // Tab-separated
let tsv_data = csv_read("data.tsv", "\t")

// =====================================================
// FILE STREAMING FOR LARGE FILES
// =====================================================

// Write large file in chunks
let stream = file_stream("large_file.txt", "w")
for i in range(1000) {
    stream.write("Line " + str(i) + " with some data\n")
}
stream.close()

// Read large file in chunks
let read_stream = file_stream("large_file.txt", "r")
let chunk_size = 1024
while true {
    let chunk = read_stream.read(chunk_size)
    if chunk.length == 0 {
        break
    }
    // Process chunk
    console.log("Read chunk of size:", chunk.length)
}
read_stream.close()

// =====================================================
// FILE OPERATIONS WITH ERROR HANDLING
// =====================================================

try {
    let protected_content = file_read("protected_file.txt")
    console.log("Protected content:", protected_content)
} catch (FileNotFoundError as e) {
    console.log("File not found:", e.message)
} catch (PermissionError as e) {
    console.log("Permission denied:", e.message)
} catch (IOError as e) {
    console.log("I/O error:", e.message)
}

// =====================================================
// ADVANCED FILE OPERATIONS
// =====================================================

// Copy files
file_copy("example.txt", "example_backup.txt")

// Move/rename files
file_move("example_backup.txt", "backup/example_backup.txt")

// Delete files
if file_exists("temp_file.txt") {
    file_delete("temp_file.txt")
    console.log("Temp file deleted")
}

// Get file info
let file_info = file_stat("example.txt")
console.log("File size:", file_info.size)
console.log("Modified time:", file_info.mtime)
console.log("Created time:", file_info.ctime)

// =====================================================
// WORKING WITH TEMPORARY FILES
// =====================================================

// Create temporary file
let temp_file = temp_file_create()
console.log("Temporary file:", temp_file)

// Write to temporary file
file_write(temp_file, "This is temporary data")

// Use temporary file
let temp_content = file_read(temp_file)
console.log("Temp content:", temp_content)

// Temporary directory
let temp_dir = temp_dir_create()
console.log("Temporary directory:", temp_dir)

// =====================================================
// FILE WATCHING (if available)
// =====================================================

try {
    // Watch directory for changes
    let watcher = file_watch(".", function(event, path) {
        console.log("File event:", event, "on", path)
    })
    
    // Create a file to trigger the watcher
    file_write("watched_file.txt", "This will trigger the watcher")
    
    // Stop watching after some time
    // watcher.stop()
} catch (ImportError as e) {
    console.log("File watching not available:", e.message)
}

// =====================================================
// CLEANUP
// =====================================================

// Clean up created files and directories
try {
    file_delete("example.txt")
    file_delete("data.txt")
    file_delete("config.json")
    file_delete("people.csv")
    file_delete("data.tsv")
    file_delete("large_file.txt")
    file_delete("watched_file.txt")
    dir_delete("test_folder")
    dir_delete("nested")
    console.log("Cleanup completed")
} catch (Exception as e) {
    console.log("Cleanup error:", e.message)
}

console.log("File handling demonstration completed!")