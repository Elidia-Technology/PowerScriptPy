    f.write("Hello from with statement!");
}

console.log("File written using with statement");

// =====================================================
// GENERATORS AND YIELD
// =====================================================

// Generator function
function fibonacci_generator(n: number) {
    let a = 0;
    let b = 1;
    for (let i = 0; i < n; i++) {
        yield a;
        let temp = a + b;
        a = b;
        b = temp;
    }
}

// Using generator
let fib_gen = fibonacci_generator(10);
console.log("First 10 Fibonacci numbers:");
for (let num of fib_gen) {
    console.log(num);
}

