// =====================================================
// FUNCTIONAL PROGRAMMING FEATURES
// =====================================================

// Higher-order functions with lambdas
function apply_operation(arr: number[], operation) {
    let result = [];
    for (let item of arr) {
        result.push(operation(item));
    }
    return result;
}

let nums = [1, 2, 3, 4, 5];
let squared_nums = apply_operation(nums, lambda x: x * x);
let cubed_nums = apply_operation(nums, lambda x: x * x * x);

console.log("Original numbers:", nums);
console.log("Squared numbers:", squared_nums);
console.log("Cubed numbers:", cubed_nums);

