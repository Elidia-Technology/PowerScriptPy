// PowerScript Advanced Language Features Test
// Tests lambda expressions, comprehensions, context managers, generators, and more

// =====================================================
// LAMBDA EXPRESSIONS
// =====================================================

// Simple lambda
let add = lambda x, y: x + y;
console.log("Lambda add result:", add(5, 3));

// Lambda with single parameter
let square = lambda x: x * x;
console.log("Lambda square result:", square(4));

// Lambda in array operations
let numbers = [1, 2, 3, 4, 5];
let doubled = numbers.map(lambda x: x * 2);
console.log("Doubled numbers:", doubled);

