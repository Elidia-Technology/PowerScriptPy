// PowerScript Comprehensions Test

// List comprehension
let squares = [x * x for x in [1, 2, 3, 4, 5]];

// List comprehension with condition
let evenSquares = [x * x for x in [1, 2, 3, 4, 5, 6] if x % 2 == 0];

// Set comprehension
let uniqueSquares = {x * x for x in [1, 2, 3, 2, 1]};

// Dict comprehension (simplified)
// let wordLengths = {word: word.length for word in ["hello", "world"]};

console.log("List comprehensions:", squares);
console.log("Conditional comprehensions:", evenSquares);
console.log("Set comprehensions:", uniqueSquares);
console.log("Comprehensions test completed!");