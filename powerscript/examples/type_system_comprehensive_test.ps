// PowerScript Advanced Type System - Comprehensive Test
// Testing all implemented type system features

// =====================================================
// 1. TYPE ALIASES
// =====================================================

// Basic type aliases
type StringType = string;
type NumberType = number;
type BooleanType = boolean;

// Union type aliases
type StringOrNumber = string | number;
type StringOrNumberOrBoolean = string | number | boolean;

// Literal type aliases  
type HttpMethod = "GET" | "POST" | "PUT" | "DELETE" | "PATCH";
type Theme = "light" | "dark" | "auto";
type StatusCode = 200 | 404 | 500;

// Complex type aliases
type UserRole = "admin" | "user" | "guest" | "moderator";
type MixedUnion = string | number | "special" | 42;

// =====================================================
// 2. UNION TYPES IN FUNCTION PARAMETERS
// =====================================================

// Simple union types
function processValue(value: string | number) {
    console.log("Processing value:", value);
}

// Complex union types
function handleInput(input: string | number | boolean | null) {
    console.log("Handling input:", input);
}

// Multiple union parameters
function combineData(a: string | number, b: boolean | null, c: "yes" | "no") {
    console.log("Combining:", a, b, c);
}

// =====================================================
// 3. TYPE ALIASES IN FUNCTION PARAMETERS
// =====================================================

// Using type aliases as parameters
function makeRequest(method: HttpMethod, url: string) {
    console.log("Making", method, "request to", url);
}

function setAppTheme(theme: Theme) {
    console.log("Setting theme to", theme);
}

function authorizeUser(role: UserRole, resource: string) {
    console.log("Authorizing", role, "for", resource);
}

// =====================================================
// 4. MIXED TYPE ALIASES AND UNION TYPES
// =====================================================

// Function using both direct unions and type aliases
function processRequest(
    method: HttpMethod,
    body: string | number | null,
    headers: StringOrNumber,
    status: StatusCode
) {
    console.log("Request:", method, body, headers, status);
}

// =====================================================
// 5. FUNCTION RETURN TYPES (when implemented)
// =====================================================

/*
// Functions with union return types
