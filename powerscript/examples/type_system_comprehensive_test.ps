    return "test";
}

function getStatus(): StatusCode {
    return 200;
}
*/

// =====================================================
// 6. TESTING ALL FEATURES
// =====================================================

console.log("=== PowerScript Advanced Type System Test ===");

// Test basic functions
processValue("hello");
processValue(42);

handleInput("text");
handleInput(123);
handleInput(true);
handleInput(null);

combineData("str", true, "yes");
combineData(456, false, "no");

// Test type alias usage
makeRequest("GET", "/api/users");
makeRequest("POST", "/api/data");

setAppTheme("dark");
setAppTheme("light");

authorizeUser("admin", "/dashboard");
authorizeUser("user", "/profile");

// Test complex combinations
processRequest("PUT", "data", "application/json", 200);
processRequest("DELETE", null, 42, 404);

console.log("=== Advanced Type System Test Completed! ===");
console.log("✅ Type aliases working");
console.log("✅ Union types working");
console.log("✅ Literal types working"); 
console.log("✅ Mixed type usage working");
console.log("✅ Function parameter type annotations working");