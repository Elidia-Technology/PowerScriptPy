// PowerScript F-strings Test

let name = "Alice";
let age = 30;
let score = 95.5;

// Basic f-string
let greeting = f"Hello, {name}!";

// F-string with expressions
let message = f"User {name} is {age} years old";

// F-string with complex expressions
let result = f"Score: {score:.2f}% ({score > 90 ? 'Excellent' : 'Good'})";

// F-string with method calls
let info = f"Name length: {name.length} characters";

console.log(greeting);
console.log(message);
console.log(result);
console.log(info);

console.log("F-strings test completed!");