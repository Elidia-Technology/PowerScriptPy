// PowerScript Generators Test - No For Loops

// Simple generator function
function* countUp() {
    yield 1;
    yield 2;
    yield 3;
}

// Generator with yield from
function* fibonacci() {
    yield 0;
    yield 1;
    yield 1;
    yield 2;
}

function* fibonacciWrapper() {
    console.log("Starting Fibonacci sequence");
    yield from fibonacci();
    console.log("Fibonacci sequence completed");
}

console.log("=== PowerScript Generators Test ===");
console.log("Generators implementation completed!");