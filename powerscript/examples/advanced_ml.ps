// PowerScript Advanced ML Pipeline Example
// Demonstrates complete machine learning workflow with PyTorch

import { torch } from "torch";
import { torch.nn as nn } from "torch";
import { torch.optim as optim } from "torch";
import { pandas as pd } from "pandas";
import { numpy as np } from "numpy";
import { sklearn.model_selection as ms } from "sklearn";

// Generic ML Model Interface
interface MLModel<T> {
    train(data: T, labels: any): Promise<void>;
    predict(data: T): Promise<any>;
    evaluate(data: T, labels: any): Promise<number>;
}

// Neural Network Implementation
class NeuralNetwork implements MLModel<torch.Tensor> {
    private model: nn.Module;
    private optimizer: optim.Optimizer;
    private criterion: nn.Module;
    
    constructor(inputSize: number, hiddenSize: number, outputSize: number) {
        this.model = nn.Sequential(
            nn.Linear(inputSize, hiddenSize),
            nn.ReLU(),
            nn.Dropout(0.2),
            nn.Linear(hiddenSize, hiddenSize),
            nn.ReLU(),
            nn.Dropout(0.2),
            nn.Linear(hiddenSize, outputSize)
        );
        
        this.optimizer = optim.Adam(this.model.parameters(), { lr: 0.001 });
        this.criterion = nn.CrossEntropyLoss();
    }
    
    async train(data: torch.Tensor, labels: torch.Tensor): Promise<void> {
        this.model.train();
        
        const epochs = 100;
        for (let epoch = 0; epoch < epochs; epoch++) {
            this.optimizer.zero_grad();
            
            const outputs = this.model.forward(data);
            const loss = this.criterion.forward(outputs, labels);
            
            loss.backward();
            this.optimizer.step();
            
            if (epoch % 10 === 0) {
                console.log(`Epoch ${epoch}, Loss: ${loss.item()}`);
            }
            
            // Yield control for async execution
            await new Promise(resolve => setTimeout(resolve, 0));
        }
    }
    
    async predict(data: torch.Tensor): Promise<torch.Tensor> {
        this.model.eval();
        const outputs = this.model.forward(data);
        return torch.softmax(outputs, 1);
    }
    
    async evaluate(data: torch.Tensor, labels: torch.Tensor): Promise<number> {
        this.model.eval();
        const outputs = this.model.forward(data);
        const predicted = torch.argmax(outputs, 1);
        const correct = (predicted === labels).sum().item();
        return correct / labels.size(0);
    }
}

// Data Pipeline Manager
class DataPipeline {
    private data: pd.DataFrame;
    private features: torch.Tensor;
    private labels: torch.Tensor;
    
    constructor() {
        this.data = null;
    }
    
    async loadData(filePath: string): Promise<void> {
        this.data = pd.read_csv(filePath);
        console.log(`Loaded data with shape: ${this.data.shape}`);
    }
    
    preprocessData(targetColumn: string): void {
        // Feature engineering
        const featureColumns = this.data.columns.filter(col => col !== targetColumn);
        const features = this.data[featureColumns].values;
        const labels = this.data[targetColumn].values;
        
        // Convert to tensors
        this.features = torch.tensor(features, { dtype: torch.float32 });
        this.labels = torch.tensor(labels, { dtype: torch.long });
        
        // Normalize features
        const mean = this.features.mean(0, { keepdim: true });
        const std = this.features.std(0, { keepdim: true });
        this.features = (this.features - mean) / std;
    }
    
    splitData(testSize: number = 0.2): {
        trainFeatures: torch.Tensor,
        testFeatures: torch.Tensor,
        trainLabels: torch.Tensor,
        testLabels: torch.Tensor
    } {
        const indices = torch.randperm(this.features.size(0));
        const splitIdx = Math.floor(this.features.size(0) * (1 - testSize));
        
        const trainIndices = indices.slice(0, splitIdx);
        const testIndices = indices.slice(splitIdx);
        
        return {
            trainFeatures: this.features.index_select(0, trainIndices),
            testFeatures: this.features.index_select(0, testIndices),
            trainLabels: this.labels.index_select(0, trainIndices),
            testLabels: this.labels.index_select(0, testIndices)
        };
    }
}

// Model Training Pipeline
class MLPipeline {
    private model: MLModel<torch.Tensor>;
    private dataPipeline: DataPipeline;
    
    constructor(model: MLModel<torch.Tensor>) {
        this.model = model;
        this.dataPipeline = new DataPipeline();
    }
    
    async runExperiment(dataPath: string, targetColumn: string): Promise<void> {
        console.log("Starting ML Pipeline...");
        
        // Load and preprocess data
        await this.dataPipeline.loadData(dataPath);
        this.dataPipeline.preprocessData(targetColumn);
        
        // Split data
        const { trainFeatures, testFeatures, trainLabels, testLabels } = 
            this.dataPipeline.splitData(0.2);
        
        console.log(`Training set size: ${trainFeatures.size(0)}`);
        console.log(`Test set size: ${testFeatures.size(0)}`);
        
        // Train model
        console.log("Training model...");
        await this.model.train(trainFeatures, trainLabels);
        
        // Evaluate model
        console.log("Evaluating model...");
        const trainAccuracy = await this.model.evaluate(trainFeatures, trainLabels);
        const testAccuracy = await this.model.evaluate(testFeatures, testLabels);
        
        console.log(`Training Accuracy: ${trainAccuracy:.4f}`);
        console.log(`Test Accuracy: ${testAccuracy:.4f}`);
        
        // Make predictions
        const predictions = await this.model.predict(testFeatures);
        console.log("Predictions completed!");
    }
}

// Hyperparameter Optimization
class HyperparameterOptimizer {
    private bestScore: number = 0;
    private bestParams: any = null;
    
    async optimize(
        modelFactory: (params: any) => MLModel<torch.Tensor>,
        paramGrid: any[],
        dataPipeline: DataPipeline
    ): Promise<any> {
        console.log("Starting hyperparameter optimization...");
        
        for (const params of paramGrid) {
            console.log(`Testing parameters: ${JSON.stringify(params)}`);
            
            const model = modelFactory(params);
            const { trainFeatures, testFeatures, trainLabels, testLabels } = 
                dataPipeline.splitData(0.2);
            
            // Train with current parameters
            await model.train(trainFeatures, trainLabels);
            const score = await model.evaluate(testFeatures, testLabels);
            
            console.log(`Score: ${score:.4f}`);
            
            if (score > this.bestScore) {
                this.bestScore = score;
                this.bestParams = params;
                console.log(`New best score: ${score:.4f}`);
            }
        }
        
        console.log(`Best parameters: ${JSON.stringify(this.bestParams)}`);
        console.log(`Best score: ${this.bestScore:.4f}`);
        
        return this.bestParams;
    }
}

// Main execution
async function main(): Promise<void> {
    // Create neural network
    const model = new NeuralNetwork(10, 64, 3); // 10 features, 3 classes
    
    // Create and run pipeline
    const pipeline = new MLPipeline(model);
    
    try {
        await pipeline.runExperiment("data/dataset.csv", "target");
    } catch (error) {
        console.error("Pipeline failed:", error);
    }
    
    // Hyperparameter optimization example
    const optimizer = new HyperparameterOptimizer();
    const paramGrid = [
        { hiddenSize: 32, lr: 0.01 },
        { hiddenSize: 64, lr: 0.001 },
        { hiddenSize: 128, lr: 0.0001 }
    ];
    
    const dataPipeline = new DataPipeline();
    await dataPipeline.loadData("data/dataset.csv");
    dataPipeline.preprocessData("target");
    
    const bestParams = await optimizer.optimize(
        (params) => new NeuralNetwork(10, params.hiddenSize, 3),
        paramGrid,
        dataPipeline
    );
    
    console.log("Optimization completed!");
}

// Export for module use
export { NeuralNetwork, DataPipeline, MLPipeline, HyperparameterOptimizer };

// Run if called directly
if (require.main === module) {
    main().catch(console.error);
}