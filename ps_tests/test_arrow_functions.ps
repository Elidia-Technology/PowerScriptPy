// Test Arrow Functions
let add = (x, y) => x + y;
let double = x => x * 2;
let greet = name => "Hello " + name;

console.log(add(5, 3));
console.log(double(7));
console.log(greet("World"));

// Arrow function with more complex body
let calculate = (a, b) => {
    let sum = a + b;
    return sum * 2;
};