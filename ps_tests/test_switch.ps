// Test Switch/Case statements
let grade = "A";
let score = 85;

// Basic switch with strings
switch (grade) {
    case "A":
        console.log("Excellent!");
        break;
    case "B":
        console.log("Good job!");
        break;
    case "C":
        console.log("Average");
        break;
    default:
        console.log("Unknown grade");
}

// Switch with multiple values and numbers
switch (score) {
    case 90, 91, 92, 93, 94, 95, 96, 97, 98, 99, 100:
        console.log("A grade");
        break;
    case 80, 81, 82, 83, 84, 85, 86, 87, 88, 89:
        console.log("B grade");
        break;
    default:
        console.log("Lower grade");
}

// Switch with expressions
let status = 1;
switch (status + 1) {
    case 1:
        console.log("Status: Pending");
        break;
    case 2:
        console.log("Status: Active");
        break;
    case 3:
        console.log("Status: Complete");
        break;
}