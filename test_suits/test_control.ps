let x = 10

if x > 5 {
    print("x is greater than 5")
} elif x == 5 {
    print("x is 5")
} else {
    print("x is less than 5")
}

for i in [1, 2, 3] {
    if i == 2 {
        continue
    }
    print(i)
}

let j = 0
while j < 3 {
    print(j)
    j = j + 1
}

match x {
    5 => print("five")
    10 => print("ten")
    _ => print("other")
}