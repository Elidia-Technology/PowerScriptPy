try{
    let x = 10;

    if (x > 5) {
        console.log("x is greater than 5");
    } elif (x == 5) {
        console.log("x is 5");
    } else {
        console.log("x is less than 5");
    }

    for (i in [1, 2, 3]) {
        if (i == 2) {
            continue;
        }
        console.log(i);
    }

    let j = 0;
    while (j < 3) {
        console.log(j);
        j = j + 1;
    }
} catch (e) {
    console.log("Error in test_control:", e);
}  