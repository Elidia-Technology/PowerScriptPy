// Test testing framework
try {
    console.log("Testing Test class...");

    let test = Test();

    // Test assert_equal
    test.assert_equal(1 + 1, 2, "Basic math");
    test.assert_equal("hello".length, 5, "String length");

    // Test assert_true/assert_false
    test.assert_true(5 > 3, "Comparison true");
    test.assert_false(3 > 5, "Comparison false");

    // Run tests
    let success = test.run();

    if (success) {
        console.log("Testing framework tests completed successfully!");
    } else {
        console.log("Testing framework tests failed!");
    }
} catch (error) {
    console.log("Testing framework test error:", error);
}