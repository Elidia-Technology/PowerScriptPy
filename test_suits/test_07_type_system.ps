// Test 07: Type System (Simplified)
// Tests: type annotations, basic types

console.log("=== Test 07: Type System ===");

// Basic type annotations
let name: string = "PowerScript";
let age: number = 1;
let isActive: boolean = true;

console.log("Name:", name);
console.log("Age:", age);
console.log("Active:", isActive);

// Function with type annotations
function add(a: number, b: number): number {
    return a + b;
}

let result = add(5, 3);
console.log("Sum:", result);

// Function with optional parameter (no type)
function greet(name: string) {
    console.log(f"Hello, {name}!");
}

greet("Alice");
greet("Bob");

// Arrays (without type annotations)
let numbers = [1, 2, 3, 4, 5];
let names = ["Alice", "Bob", "Charlie"];

console.log("Numbers:", numbers);
console.log("Names:", names);

console.log("✅ Test 07 Passed: Type System");
