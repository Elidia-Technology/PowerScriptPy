// W3C Test 34: Python Dictionary Methods
// Based on: https://www.w3schools.com/python/python_ref_dictionary.asp

console.log("=== W3C Test 34: Python Dictionary Methods ===");

// Python has a set of built-in methods for working with dictionaries

let person = {
    "name": "John",
    "age": 36,
    "country": "Norway"
};
console.log("Original dict:", person);

// clear() - Remove all elements
console.log("\n-- clear() --");
console.log("Would remove all key-value pairs");

// copy() - Return copy
console.log("\n-- copy() --");
let person_copy = person;
console.log("Copy:", person_copy);

// fromkeys() - Return dict with specified keys
console.log("\n-- fromkeys() --");
console.log("dict.fromkeys(['a', 'b', 'c'], 0)");
console.log("Result: {'a': 0, 'b': 0, 'c': 0}");

// get() - Return value of specified key
console.log("\n-- get('name') --");
let name = person["name"];
console.log("Name:", name);

console.log("get('city', 'Unknown')");
console.log("Returns default if key not found");

// items() - Return list of tuple pairs
console.log("\n-- items() --");
console.log("Returns key-value pairs");
for (key in Object.keys(person)) {
    console.log(" -", key, ":", person[key]);
}

// keys() - Return list of keys
console.log("\n-- keys() --");
let keys = Object.keys(person);
console.log("Keys:", keys);

// pop() - Remove element with specified key
console.log("\n-- pop('age') --");
console.log("Would remove 'age' and return its value");

// popitem() - Remove last inserted key-value pair
console.log("\n-- popitem() --");
console.log("Removes last inserted item");

// setdefault() - Return value of specified key
console.log("\n-- setdefault('name', 'Unknown') --");
console.log("Returns value or sets default if not exists");

// update() - Update dictionary
console.log("\n-- update() --");
console.log("person.update({'city': 'Oslo'})");
console.log("Adds or updates key-value pairs");

// values() - Return list of values
console.log("\n-- values() --");
let values = Object.values(person);
console.log("Values:", values);

// Dictionary operations
console.log("\n-- Dictionary Operations --");

// Length
console.log("len(person):", len(Object.keys(person)));

// Access value
console.log("Access:", person["name"]);

// Add/Update value
person["city"] = "Oslo";
console.log("After adding city:", person);

// Check if key exists
console.log("'name' in person checks key existence");

// Delete key
console.log("del person['age'] would remove key");

// Iteration
console.log("\nIterate through dict:");
for (key in Object.keys(person)) {
    console.log(" -", key, ":", person[key]);
}

// Nested dictionaries
console.log("\n-- Nested Dictionaries --");
let family = {
    "child1": {
        "name": "Emil",
        "year": 2004
    },
    "child2": {
        "name": "Tobias",
        "year": 2007
    }
};

console.log("Family:", family);
console.log("Child1 name:", family["child1"]["name"]);
console.log("Child2 year:", family["child2"]["year"]);

// Practical examples
console.log("\n-- Practical Examples --");

// User profile
let user = {
    "username": "john_doe",
    "email": "john@example.com",
    "age": 30,
    "is_active": true,
    "roles": ["user", "editor"]
};

console.log("User profile:");
console.log("Username:", user["username"]);
console.log("Email:", user["email"]);
console.log("Active:", user["is_active"]);
console.log("Roles:", user["roles"]);

// Configuration
let config = {
    "app_name": "MyApp",
    "version": "1.0.0",
    "debug": false,
    "max_connections": 100,
    "timeout": 30
};

console.log("\nConfiguration:");
for (key in Object.keys(config)) {
    console.log(key, ":", config[key]);
}

// Inventory
let inventory = {
    "apples": 50,
    "bananas": 30,
    "oranges": 25
};

console.log("\nInventory:");
for (item in Object.keys(inventory)) {
    console.log(item, ":", inventory[item], "units");
}

// Add item
inventory["grapes"] = 40;
console.log("Added grapes");

// Update quantity
inventory["apples"] = 60;
console.log("Updated apples");

// Score tracking
let scores = {
    "Alice": 95,
    "Bob": 87,
    "Charlie": 92,
    "Diana": 88
};

console.log("\nScores:");
let total_score = 0;
let count = 0;
for (student in Object.keys(scores)) {
    console.log(student, ":", scores[student]);
    total_score += scores[student];
    count += 1;
}
let avg_score = total_score / count;
console.log("Average score:", avg_score);

// Find highest score
let top_student = "";
let top_score = 0;
for (student in Object.keys(scores)) {
    if (scores[student] > top_score) {
        top_score = scores[student];
        top_student = student;
    }
}
console.log("Top student:", top_student, "with", top_score);

// Frequency counter
let text = "hello world";
let freq = {};
for (char in text) {
    if (char != " ") {
        // Would count frequency
    }
}
console.log("\nFrequency counter concept shown");

