// W3C Test 26: Python Dates
// Based on: https://www.w3schools.com/python/python_datetime.asp

console.log("=== W3C Test 26: Python Dates ===");

// Python has a datetime module for working with dates

// Import datetime module
console.log("import datetime");

// Display current date
console.log("\nCurrent date:");
console.log("x = datetime.datetime.now()");
console.log("print(x)");

// Date output
console.log("\nDate contains: year, month, day, hour, minute, second, microsecond");

// Creating date objects
console.log("\n-- Creating Date Objects --");
console.log("x = datetime.datetime(2020, 5, 17)");
console.log("print(x)");

// The strftime() method
console.log("\n-- strftime() Method --");
console.log("Format date into readable string");

// Format codes
console.log("\nCommon format codes:");
console.log("%a - Weekday, short (Wed)");
console.log("%A - Weekday, full (Wednesday)");
console.log("%w - Weekday as number (0-6)");
console.log("%d - Day of month (01-31)");
console.log("%b - Month name, short (Dec)");
console.log("%B - Month name, full (December)");
console.log("%m - Month as number (01-12)");
console.log("%y - Year, short (18)");
console.log("%Y - Year, full (2018)");
console.log("%H - Hour 00-23");
console.log("%I - Hour 00-12");
console.log("%p - AM/PM");
console.log("%M - Minute 00-59");
console.log("%S - Second 00-59");
console.log("%f - Microsecond");
console.log("%z - UTC offset");
console.log("%Z - Timezone");
console.log("%j - Day number of year");
console.log("%U - Week number of year (Sunday start)");
console.log("%W - Week number of year (Monday start)");
console.log("%c - Local date and time");
console.log("%x - Local date");
console.log("%X - Local time");

// Examples
console.log("\n-- Format Examples --");
console.log("x = datetime.datetime(2018, 6, 1)");
console.log("x.strftime('%B')  # June");
console.log("x.strftime('%A')  # Friday");

// PowerScript date simulation
console.log("\n-- Date Handling in PS --");

// Date object (simplified)
let current_date = {
    "year": 2025,
    "month": 10,
    "day": 11,
    "hour": 14,
    "minute": 30,
    "second": 45,
    "format": function(fmt) {
        return "2025-10-11 14:30:45"; // Simplified
    }
};

console.log("Current date:", current_date["year"], "-", current_date["month"], "-", current_date["day"]);
console.log("Time:", current_date["hour"], ":", current_date["minute"], ":", current_date["second"]);

// Date operations
console.log("\n-- Date Operations --");

// Date arithmetic
console.log("import datetime");
console.log("import timedelta");
console.log("");
console.log("# Add days");
console.log("future = datetime.datetime.now() + datetime.timedelta(days=7)");
console.log("");
console.log("# Subtract days");
console.log("past = datetime.datetime.now() - datetime.timedelta(days=7)");

// Date comparison
console.log("\n-- Date Comparison --");
console.log("date1 = datetime.datetime(2020, 5, 17)");
console.log("date2 = datetime.datetime(2021, 5, 17)");
console.log("if date1 < date2:");
console.log("    print('date1 is earlier')");

// Parsing dates
console.log("\n-- Parsing Dates --");
console.log("date_string = '2020-05-17'");
console.log("date_obj = datetime.datetime.strptime(date_string, '%Y-%m-%d')");

// Timezone
console.log("\n-- Timezone --");
console.log("import pytz");
console.log("tz = pytz.timezone('America/New_York')");
console.log("now = datetime.datetime.now(tz)");

// Practical examples
console.log("\n-- Practical Examples --");

// Age calculator
console.log("Calculate age:");
console.log("birth_year = 1990");
console.log("current_year = datetime.datetime.now().year");
console.log("age = current_year - birth_year");

let birth_year = 1990;
let current_year = 2025;
let age = current_year - birth_year;
console.log("Age:", age);

// Days until event
console.log("\nDays until event:");
console.log("event_date = datetime.datetime(2025, 12, 31)");
console.log("today = datetime.datetime.now()");
console.log("days_left = (event_date - today).days");

console.log("\n✅ W3C Test 26 Passed: Python Dates");
console.log("Note: Full datetime support may be added to PowerScript in the future");
