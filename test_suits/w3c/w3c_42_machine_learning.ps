// Simple linear regression simulation
console.log("\n-- PowerScript ML Simulation --");

let LinearModel = {
    "slope": 0,
    "intercept": 0,
    
    "fit": function(X, y) {
        console.log("Training linear model...");
        // Simplified: y = 2x + 1
        LinearModel["slope"] = 2;
        LinearModel["intercept"] = 1;
        console.log("Model trained!");
        console.log("Slope:", LinearModel["slope"]);
        console.log("Intercept:", LinearModel["intercept"]);
    },
    
    "predict": function(X) {
        console.log("Making predictions...");
        let predictions = [];
        for (let i = 0; i < len(X); i += 1) {
            let x_val = X[i][0];
            let pred = LinearModel["slope"] * x_val + LinearModel["intercept"];
            predictions.append(pred);
        }
        return predictions;
    },
    
    "score": function(X, y_true) {
        console.log("Calculating R² score...");
        return 0.95;
    }
};

console.log("\n-- Training Model --");
LinearModel["fit"](X, y);

console.log("\n-- Making Predictions --");
let test_X = [[6, 7], [7, 8], [8, 9]];
let predictions = LinearModel["predict"](test_X);
console.log("Predictions:", predictions);

console.log("\n-- Model Evaluation --");
let score = LinearModel["score"](X, y);
console.log("R² Score:", score);
console.log("(1.0 = perfect fit, 0.0 = no fit)");

