// Simulation
console.log("\n-- Simulation: Classification --");

let IrisClassifier = {
    "fit": function(X, y) {
        console.log("Training Iris classifier...");
        console.log("Training samples:", len(X));
        console.log("Model trained!");
    },
    
    "predict": function(X) {
        console.log("Classifying", len(X), "samples...");
        return [0, 1, 2, 1, 0];
    },
    
    "accuracy": function(y_true, y_pred) {
        let correct = 0;
        for (let i = 0; i < len(y_true); i += 1) {
            if (y_true[i] == y_pred[i]) {
                correct += 1;
            }
        }
        return correct / len(y_true);
    }
};

let iris_X_train = [[5.1, 3.5, 1.4, 0.2], [4.9, 3.0, 1.4, 0.2]];
let iris_y_train = [0, 0];

IrisClassifier["fit"](iris_X_train, iris_y_train);

let iris_X_test = [[5.0, 3.4, 1.5, 0.2]];
let iris_predictions = IrisClassifier["predict"](iris_X_test);
console.log("Predictions:", iris_predictions);

