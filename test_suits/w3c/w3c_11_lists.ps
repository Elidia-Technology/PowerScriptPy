// W3C Test 11: Python Lists
// Based on: https://www.w3schools.com/python/python_lists.asp

console.log("=== W3C Test 11: Python Lists ===");

// List creation
let mylist = ["apple", "banana", "cherry"];
console.log("List:", mylist);

// List items
console.log("First item:", mylist[0]);
console.log("Second item:", mylist[1]);
console.log("Third item:", mylist[2]);

// List length
console.log("List length:", len(mylist));

// List items - data types
let list1 = ["apple", "banana", "cherry"];
let list2 = [1, 5, 7, 9, 3];
let list3 = [true, false, true];
console.log("String list:", list1);
console.log("Number list:", list2);
console.log("Boolean list:", list3);

// List with different data types
let mixed = ["abc", 34, true, 40, "male"];
console.log("Mixed list:", mixed);

// Type checking
console.log("Type:", typeof mylist);

// Access items
let fruits = ["apple", "banana", "cherry"];
console.log("Second fruit:", fruits[1]);

// Negative indexing (not yet supported in PS)
// console.log("Last item:", fruits[-1]);

// Range of indexes (slicing - not yet fully supported)
// let slice = fruits[1:3];
console.log("Slicing would extract range");

// Check if item exists
// In Python: if "apple" in fruits
console.log("Checking existence:", fruits);

// Change item value
fruits[1] = "blackcurrant";
console.log("After change:", fruits);

// Change range of values
// fruits[1:3] = ["blackcurrant", "watermelon"]

// Insert items
fruits.push("orange");
console.log("After push:", fruits);

// Add items
fruits.append("mango");
console.log("After append:", fruits);

// Extend list
let tropical = ["mango", "pineapple", "papaya"];
// fruits.extend(tropical)
console.log("Tropical:", tropical);

// Remove item
// fruits.remove("banana")
console.log("Remove would delete specific item");

// Remove by index
// fruits.pop(1)
console.log("Pop would remove by index");

// Delete keyword
// del fruits[0]

// Clear list
// fruits.clear()

// Loop through list
console.log("\nLoop through fruits:");
for (fruit in fruits) {
    console.log(" -", fruit);
}

// List comprehension (not yet supported in PS)
// newlist = [x for x in fruits if "a" in x]

// Sort list
let numbers = [5, 2, 8, 1, 9];
// numbers.sort()
console.log("Numbers to sort:", numbers);

// Reverse list
// numbers.reverse()

// Copy list
let copy_fruits = fruits;
console.log("Copy:", copy_fruits);

// Join lists
let list_a = ["a", "b", "c"];
let list_b = [1, 2, 3];
// list_c = list_a + list_b
console.log("Lists to join:", list_a, list_b);

console.log("\n✅ W3C Test 11 Passed: Python Lists");
