// W3C Test 23: Python Iterators
// Based on: https://www.w3schools.com/python/python_iterators.asp

console.log("=== W3C Test 23: Python Iterators ===");

// An iterator is an object that contains a countable number of values
// An iterator is an object that can be iterated upon

// Iterator vs Iterable
console.log("Iterable: list, tuple, dict, set, string");
console.log("Iterator: object with __iter__() and __next__()");

// Looping through an iterator
let mytuple = ["apple", "banana", "cherry"];
console.log("\nLoop through tuple:");
for (x in mytuple) {
    console.log(x);
}

// Looping through a string
console.log("\nLoop through string:");
for (x in "banana") {
    console.log(x);
}

// Create an iterator
console.log("\nCreate iterator syntax:");
console.log("myit = iter(mytuple)");
console.log("print(next(myit))");
console.log("print(next(myit))");
console.log("print(next(myit))");

// StopIteration
console.log("\nStopIteration is raised when no more items");

// Create an iterator class
console.log("\nIterator class syntax:");
console.log("class MyNumbers:");
console.log("    def __iter__(self):");
console.log("        self.a = 1");
console.log("        return self");
console.log("    def __next__(self):");
console.log("        x = self.a");
console.log("        self.a += 1");
console.log("        return x");

// StopIteration in custom iterator
console.log("\nStop after n iterations:");
console.log("class MyNumbers:");
console.log("    def __iter__(self):");
console.log("        self.a = 1");
console.log("        return self");
console.log("    def __next__(self):");
console.log("        if self.a <= 20:");
console.log("            x = self.a");
console.log("            self.a += 1");
console.log("            return x");
console.log("        else:");
console.log("            raise StopIteration");

// Manual iteration in PowerScript
console.log("\n-- Manual iteration (available in PS) --");

let fruits = ["apple", "banana", "cherry"];
let index = 0;

console.log("Manual iteration:");
while (index < len(fruits)) {
    console.log(fruits[index]);
    index += 1;
}

// Generator concept (yield in Python)
console.log("\n-- Generator concept --");
console.log("Generators use yield instead of return");
console.log("def my_generator():");
console.log("    yield 1");
console.log("    yield 2");
console.log("    yield 3");

// Generator function simulation
function* simple_generator() {
    // Generator syntax may not be fully supported in PS
    console.log("Generator concept shown");
}

// Iterator methods
console.log("\n-- Iterator methods --");
console.log("__iter__(): Returns iterator object");
console.log("__next__(): Returns next item");

// Infinite iterator
console.log("\nInfinite iterator:");
console.log("Create iterator that never ends");
console.log("Use break to stop");

// Practical example: Range iterator
console.log("\n-- Range-like iterator --");
function range_iterator(start, end) {
    let current = start;
    return {
        "next": function() {
            if (current < end) {
                let value = current;
                current += 1;
                return {"value": value, "done": false};
            }
            return {"value": null, "done": true};
        }
    };
}

let iter = range_iterator(0, 5);
console.log("Range iterator:");
let result = iter["next"]();
while (!result["done"]) {
    console.log(result["value"]);
    result = iter["next"]();
}

console.log("\n✅ W3C Test 23 Passed: Python Iterators");
console.log("Note: Full iterator support may be added to PowerScript in the future");
