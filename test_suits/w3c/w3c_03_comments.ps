// W3C Test 03: Python Comments
// Based on: https://www.w3schools.com/python/python_comments.asp

console.log("=== W3C Test 03: Python Comments ===");

// Single line comments
// This is a comment
console.log("Hello, World!");

// Comments can be placed at the end of a line
console.log("Hello!"); // This is a comment

/*
Multi-line comments
Python uses triple quotes for multi-line comments
PowerScript uses C-style /* */ 
*/

console.log("Comments are useful for documentation");

// Comments to explain code
let x = 5; // Initialize x
let y = 10; // Initialize y
let z = x + y; // Add x and y
console.log("Result:", z);

console.log("\n✅ W3C Test 03 Passed: Python Comments");
