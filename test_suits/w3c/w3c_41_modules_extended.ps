// Practical example: Math utilities module
console.log("\n-- Practical: Math Utilities --");

let MathUtils = {
    "PI": 3.14159,
    "E": 2.71828,
    
    "circle_area": function(radius) {
        return MathUtils["PI"] * radius * radius;
    },
    
    "circle_circumference": function(radius) {
        return 2 * MathUtils["PI"] * radius;
    },
    
    "rectangle_area": function(width, height) {
        return width * height;
    },
    
    "rectangle_perimeter": function(width, height) {
        return 2 * (width + height);
    },
    
    "triangle_area": function(base, height) {
        return 0.5 * base * height;
    }
};

console.log("\nMath Utilities:");
console.log("Circle area (r=5):", MathUtils["circle_area"](5));
console.log("Circle circumference (r=5):", MathUtils["circle_circumference"](5));
console.log("Rectangle area (3x4):", MathUtils["rectangle_area"](3, 4));
console.log("Triangle area (base=6, height=4):", MathUtils["triangle_area"](6, 4));

// Practical example: String utilities module
console.log("\n-- Practical: String Utilities --");

let StringUtils = {
    "reverse": function(text) {
        let result = "";
        for (let i = len(text) - 1; i >= 0; i -= 1) {
            result += text[i];
        }
        return result;
    },
    
    "is_palindrome": function(text) {
        return text == StringUtils["reverse"](text);
    },
    
    "count_vowels": function(text) {
        let vowels = ["a", "e", "i", "o", "u"];
        let count = 0;
        for (let i = 0; i < len(text); i += 1) {
            if (text[i].lower() in vowels) {
                count += 1;
            }
        }
        return count;
    },
    
    "title_case": function(text) {
        return text.title();
    }
};

console.log("\nString Utilities:");
console.log("Reverse 'hello':", StringUtils["reverse"]("hello"));
console.log("Is 'radar' palindrome?", StringUtils["is_palindrome"]("radar"));
console.log("Vowels in 'hello':", StringUtils["count_vowels"]("hello"));

console.log("\n✅ W3C Test 41 Passed: Python Modules - Extended");
