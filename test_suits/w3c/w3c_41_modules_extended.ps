// PowerScript module simulation
console.log("\n-- PowerScript Module System --");

let MyModule = {
    "greet": function(name) {
        return f"Hello, {name}!";
    },
    "PI": 3.14159,
    "calculate_area": function(radius) {
        return MyModule["PI"] * radius * radius;
    }
};

console.log("\nUsing custom module:");
console.log(MyModule["greet"]("World"));
console.log("PI:", MyModule["PI"]);
console.log("Area of circle (r=5):", MyModule["calculate_area"](5));

