// W3C Test 22: Python Inheritance
// Based on: https://www.w3schools.com/python/python_inheritance.asp

console.log("=== W3C Test 22: Python Inheritance ===");

// Inheritance allows us to define a class that inherits
// all methods and properties from another class

console.log("Parent class syntax:");
console.log("class Person:");
console.log("    def __init__(self, fname, lname):");
console.log("        self.firstname = fname");
console.log("        self.lastname = lname");
console.log("    def printname(self):");
console.log("        print(self.firstname, self.lastname)");

console.log("\nChild class syntax:");
console.log("class Student(Person):");
console.log("    pass");

// Use the child class
console.log("\nUsing child class:");
console.log("x = Student('Mike', 'Olsen')");
console.log("x.printname()");

// Add __init__ function
console.log("\nChild class with init:");
console.log("class Student(Person):");
console.log("    def __init__(self, fname, lname):");
console.log("        Person.__init__(self, fname, lname)");

// Use super() function
console.log("\nUsing super():");
console.log("class Student(Person):");
console.log("    def __init__(self, fname, lname):");
console.log("        super().__init__(fname, lname)");

// Add properties
console.log("\nAdd properties:");
console.log("class Student(Person):");
console.log("    def __init__(self, fname, lname, year):");
console.log("        super().__init__(fname, lname)");
console.log("        self.graduationyear = year");

// Add methods
console.log("\nAdd methods:");
console.log("class Student(Person):");
console.log("    def __init__(self, fname, lname, year):");
console.log("        super().__init__(fname, lname)");
console.log("        self.graduationyear = year");
console.log("    def welcome(self):");
console.log("        print('Welcome', self.firstname, self.lastname)");

// Alternative: Object composition in PowerScript
console.log("\n-- Object composition approach (available in PS) --");

// Base object factory
function create_person(firstname, lastname) {
    return {
        "firstname": firstname,
        "lastname": lastname,
        "printname": function() {
            console.log(firstname, lastname);
        }
    };
}

// Extended object factory (composition)
function create_student(firstname, lastname, year) {
    let person = create_person(firstname, lastname);
    return {
        "firstname": person["firstname"],
        "lastname": person["lastname"],
        "graduationyear": year,
        "printname": person["printname"],
        "welcome": function() {
            console.log("Welcome", firstname, lastname, "to class of", year);
        }
    };
}

let student1 = create_student("Mike", "Olsen", 2019);
console.log("Student:", student1["firstname"], student1["lastname"]);
console.log("Graduation year:", student1["graduationyear"]);

// Multiple inheritance concept
console.log("\n-- Multiple Inheritance (Python) --");
console.log("class Child(Parent1, Parent2):");
console.log("    pass");

// Method resolution order
console.log("\nMRO: Child -> Parent1 -> Parent2 -> object");

console.log("\n✅ W3C Test 22 Passed: Python Inheritance");
console.log("Note: Full inheritance support may be added to PowerScript in the future");
