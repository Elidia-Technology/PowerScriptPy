// W3C Test 02: Python Syntax
// Based on: https://www.w3schools.com/python/python_syntax.asp

console.log("=== W3C Test 02: Python Syntax ===");

// Python syntax
console.log("Hello, World!");

// Indentation
let x = 5;
if (x > 3) {
    console.log("x is greater than 3");
}

// Variables
let myvar = "John";
console.log("Variable:", myvar);

// Comments (single line)
// This is a comment
console.log("Comments are ignored");

// Multiple statements
let a = 5;
let b = 10;
let c = a + b;
console.log("Sum:", c);

console.log("\n✅ W3C Test 02 Passed: Python Syntax");
