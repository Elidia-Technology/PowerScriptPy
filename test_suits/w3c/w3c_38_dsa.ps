console.log("\n-- Searching Algorithms --");

// Linear Search
console.log("Linear Search: O(n)");
console.log("Check each element sequentially");

function linear_search(arr, target) {
    for (let i = 0; i < len(arr); i += 1) {
        if (arr[i] == target) {
            return i;
        }
    }
    return -1;
}

let numbers = [10, 20, 30, 40, 50];
let index = linear_search(numbers, 30);
console.log("Found at index:", index);

// Binary Search
console.log("\nBinary Search: O(log n)");
console.log("Requires sorted array");
console.log("Divide search space in half each time");

function binary_search(arr, target) {
    let left = 0;
    let right = len(arr) - 1;
    
    while (left <= right) {
        let mid = int((left + right) / 2);
        if (arr[mid] == target) {
            return mid;
        } else if (arr[mid] < target) {
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }
    return -1;
}

let sorted_arr = [10, 20, 30, 40, 50];
let found_idx = binary_search(sorted_arr, 30);
console.log("Binary search found at:", found_idx);

console.log("\n-- Recursion --");
console.log("Function calls itself");

function factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

console.log("Factorial(5):", factorial(5));

function fibonacci(n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

console.log("Fibonacci(7):", fibonacci(7));

console.log("\n-- Dynamic Programming --");
console.log("Store solutions to subproblems");
console.log("Avoid redundant calculations");

// Fibonacci with memoization
let fib_cache = {};

function fib_memo(n) {
    if (n <= 1) {
        return n;
    }
    if (n in Object.keys(fib_cache)) {
        return fib_cache[n];
    }
    fib_cache[n] = fib_memo(n - 1) + fib_memo(n - 2);
    return fib_cache[n];
}

console.log("Memoized Fibonacci(10):", fib_memo(10));

console.log("\n-- Greedy Algorithms --");
console.log("Make locally optimal choice");
console.log("Example: Coin change problem");

function min_coins(amount, coins) {
    let count = 0;
    for (let i = len(coins) - 1; i >= 0; i -= 1) {
        while (amount >= coins[i]) {
            amount -= coins[i];
            count += 1;
        }
    }
    return count;
}

let coin_types = [1, 5, 10, 25];
console.log("Min coins for 63 cents:", min_coins(63, coin_types));

