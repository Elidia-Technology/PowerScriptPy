console.log("\n-- Sorting Algorithms --");

// Bubble Sort
console.log("Bubble Sort: O(n²)");
console.log("Compare adjacent elements, swap if wrong order");

function bubble_sort(arr) {
    let n = len(arr);
    for (let i = 0; i < n; i += 1) {
        for (let j = 0; j < n - i - 1; j += 1) {
            if (arr[j] > arr[j + 1]) {
                let temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
    return arr;
}

let unsorted = [64, 34, 25, 12, 22, 11, 90];
console.log("Unsorted:", unsorted);
console.log("Bubble sort would sort to:", [11, 12, 22, 25, 34, 64, 90]);

