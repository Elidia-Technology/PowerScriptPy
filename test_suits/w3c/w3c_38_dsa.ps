// Find maximum in array
function find_max(arr) {
    let max_val = arr[0];
    for (item in arr) {
        if (item > max_val) {
            max_val = item;
        }
    }
    return max_val;
}

console.log("Max of [3, 7, 2, 9, 1]:", find_max([3, 7, 2, 9, 1]));

// Check if palindrome
function is_palindrome(text) {
    let left = 0;
    let right = len(text) - 1;
    while (left < right) {
        if (text[left] != text[right]) {
            return false;
        }
        left += 1;
        right -= 1;
    }
    return true;
}

console.log("'radar' is palindrome:", is_palindrome("radar"));
console.log("'hello' is palindrome:", is_palindrome("hello"));

// Two sum problem
function two_sum(arr, target) {
    let seen = {};
    for (let i = 0; i < len(arr); i += 1) {
        let complement = target - arr[i];
        if (complement in Object.keys(seen)) {
            return [seen[complement], i];
        }
        seen[arr[i]] = i;
    }
    return [-1, -1];
}

console.log("Two sum [2,7,11,15] target 9:", two_sum([2, 7, 11, 15], 9));

