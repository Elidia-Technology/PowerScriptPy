// W3C Test 31: Python File Handling
// Based on: https://www.w3schools.com/python/python_file_handling.asp

console.log("=== W3C Test 31: Python File Handling ===");

// File handling is an important part of any web application
// Python has several functions for creating, reading, updating, and deleting files

// Open a file
console.log("\n-- Open File --");
console.log("f = open('demofile.txt')");
console.log("f = open('demofile.txt', 'r')");

// Open modes
console.log("\n-- File Modes --");
console.log("'r' - Read (default) - Error if file doesn't exist");
console.log("'a' - Append - Creates file if doesn't exist");
console.log("'w' - Write - Creates file if doesn't exist");
console.log("'x' - Create - Error if file exists");

// Mode modifiers
console.log("\n't' - Text mode (default)");
console.log("'b' - Binary mode");

// Read file
console.log("\n-- Read File --");
console.log("f = open('demofile.txt', 'r')");
console.log("print(f.read())");
console.log("f.close()");

// Read lines
console.log("\n-- Read Lines --");
console.log("f = open('demofile.txt', 'r')");
console.log("print(f.readline())");
console.log("f.close()");

// Loop through file
console.log("\n-- Loop Through File --");
console.log("f = open('demofile.txt', 'r')");
console.log("for x in f:");
console.log("    print(x)");
console.log("f.close()");

// Close file
console.log("\n-- Close File --");
console.log("Always close files!");
console.log("f.close()");

// Write to file
console.log("\n-- Write to File --");
console.log("f = open('demofile.txt', 'a')");
console.log("f.write('Now the file has more content!')");
console.log("f.close()");

// Overwrite file
console.log("\n-- Overwrite File --");
console.log("f = open('demofile.txt', 'w')");
console.log("f.write('Woops! I have deleted the content!')");
console.log("f.close()");

// Create new file
console.log("\n-- Create New File --");
console.log("f = open('myfile.txt', 'x')");
console.log("f = open('myfile.txt', 'w')");
console.log("f = open('myfile.txt', 'a')");

// Delete file
console.log("\n-- Delete File --");
console.log("import os");
console.log("os.remove('demofile.txt')");

// Check if file exists
console.log("\n-- Check if File Exists --");
console.log("import os");
console.log("if os.path.exists('demofile.txt'):");
console.log("    os.remove('demofile.txt')");
console.log("else:");
console.log("    print('File does not exist')");

// Delete folder
console.log("\n-- Delete Folder --");
console.log("import os");
console.log("os.rmdir('myfolder')");

// PowerScript file handling
console.log("\n-- File Operations in PS --");

// Using FileSystem module
console.log("Using FileSystem module:");
console.log("let content = FileSystem.read('file.txt');");
console.log("FileSystem.write('file.txt', 'content');");
console.log("FileSystem.append('file.txt', 'more content');");
console.log("FileSystem.delete('file.txt');");

// File operations object
let file_ops = {
    "read": function(filename) {
        console.log("Reading file:", filename);
        return "File content here";
    },
    "write": function(filename, content) {
        console.log("Writing to file:", filename);
        console.log("Content:", content);
    },
    "append": function(filename, content) {
        console.log("Appending to file:", filename);
        console.log("Content:", content);
    },
    "delete": function(filename) {
        console.log("Deleting file:", filename);
    },
    "exists": function(filename) {
        console.log("Checking if exists:", filename);
        return true;
    }
};

// Example usage
console.log("\nFile operation examples:");
let content = file_ops["read"]("data.txt");
console.log("Read content:", content);

file_ops["write"]("output.txt", "Hello, World!");
file_ops["append"]("output.txt", "\nNew line");

if (file_ops["exists"]("temp.txt")) {
    file_ops["delete"]("temp.txt");
}

// With statement (context manager in Python)
console.log("\n-- With Statement --");
console.log("with open('demofile.txt', 'r') as f:");
console.log("    print(f.read())");
console.log("# File automatically closed");

// Binary files
console.log("\n-- Binary Files --");
console.log("with open('image.jpg', 'rb') as f:");
console.log("    data = f.read()");

// File positions
console.log("\n-- File Positions --");
console.log("f.tell() - Current position");
console.log("f.seek(0) - Move to beginning");
console.log("f.seek(0, 2) - Move to end");

// File methods
console.log("\n-- File Methods --");
console.log("read() - Read entire file");
console.log("read(size) - Read n bytes");
console.log("readline() - Read one line");
console.log("readlines() - Read all lines to list");
console.log("write() - Write string to file");
console.log("writelines() - Write list of strings");
console.log("close() - Close file");
console.log("flush() - Flush buffer");
console.log("seek() - Change file position");
console.log("tell() - Return current position");

console.log("\n✅ W3C Test 31 Passed: Python File Handling");
console.log("Note: FileSystem module available in PowerScript runtime");
