// Test crypto features
try {
    console.log("Testing Crypto class...");

    // Test hashing
    let data = "Hello, PowerScript!";
    let sha256 = Crypto.hash_sha256(data);
    console.log("SHA256 hash:", sha256);

    let md5 = Crypto.hash_md5(data);
    console.log("MD5 hash:", md5);

    // Test base64 encoding/decoding
    let encoded = Crypto.base64_encode(data);
    console.log("Base64 encoded:", encoded);

    let decoded = Crypto.base64_decode(encoded);
    console.log("Base64 decoded:", decoded);

    console.log("Crypto tests completed successfully!");
} catch (error) {
    console.log("Crypto test error:", error);
}