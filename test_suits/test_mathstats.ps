// Test math/stats features
try {
    console.log("Testing MathStats class...");

    let data = [1, 2, 3, 4, 5];

    let mean_val = MathStats.mean(data);
    console.log("Mean:", mean_val);

    let median_val = MathStats.median(data);
    console.log("Median:", median_val);

    let std_val = MathStats.std(data);
    console.log("Standard deviation:", std_val);

    let linspace_data = MathStats.linspace(0, 10, 5);
    console.log("Linspace:", linspace_data);

    let arange_data = MathStats.arange(5);
    console.log("Arange:", arange_data);

    console.log("MathStats tests completed successfully!");
} catch (error) {
    console.log("MathStats test error:", error);
}