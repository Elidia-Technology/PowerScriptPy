class Person {
    name: String
    age: Int

    init(name: String, age: Int) {
        self.name = name
        self.age = age
    }

    func greet() -> String {
        return "Hello, my name is " + self.name
    }
}

let p = Person("Alice", 30)
print(p.greet())
print(p.age)

class Student extends Person {
    grade: String

    init(name: String, age: Int, grade: String) {
        super.init(name, age)
        self.grade = grade
    }

    func study() -> String {
        return self.name + " is studying in grade " + self.grade
    }
}

let s = Student("Bob", 20, "A")
print(s.greet())
print(s.study())