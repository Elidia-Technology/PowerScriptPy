enum Color {
    Red,
    Green,
    Blue
}

let c = Color.Red;
console.log(c);

with open("temp.txt", "w") as f {
    f.write("test");
}

let data = [1, 2, 3, 4, 5];
let filtered = data.filter(x => x > 2);
console.log(filtered);

let mapped = data.map(x => x * 2);
console.log(mapped);

let sum = data.reduce((acc, x) => acc + x, 0);
console.log(sum);