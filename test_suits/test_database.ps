try {
    let db = create_database(":memory:");
    db.create_table("users", {"id": "INTEGER PRIMARY KEY", "name": "TEXT", "age": "INTEGER"});
    
    let user_id = db.insert("users", {"name": "Alice", "age": 30});
    console.log("Inserted user with id:", user_id);
    
    let users = db.select("users");
    console.log("Users:", users);
    
    let alice = db.select("users", {"name": "Alice"});
    console.log("Alice:", alice);
    
    db.disconnect();
    console.log("test_database passed");
} catch (e) {
    console.log("Error in test_database:", e);
}