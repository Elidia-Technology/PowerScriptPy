try{
    let arr = [1, 2, 3, 4, 5];
    console.log(arr);

    arr.push(6);
    console.log(arr);

    console.log(arr.length);
    console.log(arr[0]);
    console.log(Array.slice(arr, 1, 4));

    arr[2] = 10;
    console.log(arr);

    let matrix = [[1, 2], [3, 4]];
    console.log(matrix);
} catch (e) {
    console.log("Error in test_array:", e);
}  