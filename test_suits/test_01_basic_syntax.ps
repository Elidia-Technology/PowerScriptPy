// Test 01: Basic Syntax and Variables
// Tests: let, const, basic types, console.log

console.log("=== Test 01: Basic Syntax ===");

// Variable declarations
let x = 5;
let y = 10;
const PI = 3.14159;

console.log("x =", x);
console.log("y =", y);
console.log("PI =", PI);

// Basic arithmetic
let sum = x + y;
let product = x * y;
let quotient = y / x;

console.log("sum:", sum);
console.log("product:", product);
console.log("quotient:", quotient);

// String operations
let name = "PowerScript";
let version = "1.0.0";
let message = name + " v" + version;

console.log("Message:", message);

// Boolean operations
let isTrue = true;
let isFalse = false;
let comparison = x < y;

console.log("isTrue:", isTrue);
console.log("isFalse:", isFalse);
console.log("x < y:", comparison);

// Null and undefined
let nullValue = null;
console.log("nullValue:", nullValue);

console.log("✅ Test 01 Passed: Basic Syntax");
