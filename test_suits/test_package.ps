console.log("Testing Package Manager functionality");

// Test listing installed packages
console.log("Installed packages:");
let packages = PackageManager.list_installed();
console.log(Array.slice(packages, 0, 5)); // Show first 5 packages

// Test package info (using a common package that should be installed)
console.log("\nTesting package info for 'pip':");
let info = PackageManager.show_info("pip");
console.log(info);

// Note: We won't test install/uninstall in automated tests to avoid modifying the system
console.log("\nPackage Manager basic functionality test completed");