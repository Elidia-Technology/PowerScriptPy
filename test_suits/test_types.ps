try {
    let x: number | string = 5;
    console.log(x);

    x = "hello";
    console.log(x);

    let y: number? = 10;
    console.log(y);

    y = null;
    console.log(y);

    let z: Array<number> = [1, 2, 3];
    console.log(z);

    let w = {"a": 1};
    console.log(w);

    type MyType = number | string;
    let m: MyType = "test";
    console.log(m);

    console.log("test_types passed");
} catch (e) {
    console.log("Error in test_types:", e);
}