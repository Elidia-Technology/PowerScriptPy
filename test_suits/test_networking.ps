// Test networking features
try {
    console.log("Testing Network class...");

    // Test GET request (using a simple API)
    let response = Network.get("https://httpbin.org/get");
    console.log("GET response received, length:", response.length);

    // Test POST request
    let postData = {"test": "data", "number": 42};
    let postResponse = Network.post("https://httpbin.org/post", postData);
    console.log("POST response received, length:", postResponse.length);

    // Test download (small file)
    let downloadResult = Network.download("https://httpbin.org/json", "test_download.json");
    console.log("Download result:", downloadResult);

    console.log("Networking tests completed successfully!");
} catch (error) {
    console.log("Networking test error:", error);
}