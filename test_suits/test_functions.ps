func add(a: Int, b: Int) -> Int {
    return a + b
}

let result = add(5, 3)
print(result)

func greet(name: String) -> String {
    return "Hello, " + name
}

print(greet("World"))

func factorial(n: Int) -> Int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

print(factorial(5))

let lambda = (x: Int) => x * 2
print(lambda(4))