
try {
    let x: number = 5;
    console.log(x);

    let y: string = "hello";
    console.log(y);

    let z: number = 3.14;
    console.log(z);

    let a: boolean = true;
    console.log(a);

    let b: boolean = false;
    console.log(b);

    let arr: Array<number> = [1, 2, 3];
    console.log(arr);

    let dict = {"a": 1, "b": 2};
    console.log(dict);

    let result: number = x + 10;
    console.log(result);

    if (x > 0) {
        console.log("positive");
    } else {
        console.log("non-positive");
    }

    for (i in arr) {
        console.log(i);
    }

    while (x > 0) {
        console.log(x);
        x = x - 1;
    }
} catch (e) {
    console.log("Error in test_basic:", e);
}    
console.log("test_basic passed");
