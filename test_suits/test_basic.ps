let x: Int = 5
print(x)

let y: String = "hello"
print(y)

let z: Float = 3.14
print(z)

let a: Bool = true
print(a)

let b: Bool = false
print(b)

let arr: [Int] = [1, 2, 3]
print(arr)

let dict: {String: Int} = {"a": 1, "b": 2}
print(dict)

let result: Int = x + 10
print(result)

if x > 0 {
    print("positive")
} else {
    print("non-positive")
}

for i in arr {
    print(i)
}

while x > 0 {
    print(x)
    x = x - 1
}