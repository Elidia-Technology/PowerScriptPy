// Test 03: Functions
// Tests: function declaration, parameters, return values, default parameters

console.log("=== Test 03: Functions ===");

// Simple function
function greet(name) {
    console.log("Hello,", name);
}

greet("World");
greet("PowerScript");

// Function with return value
function add(a, b) {
    return a + b;
}

let result = add(5, 3);
console.log("5 + 3 =", result);

// Function with multiple returns
function getSign(num) {
    if (num > 0) {
        return "positive";
    } else if (num < 0) {
        return "negative";
    } else {
        return "zero";
    }
}

console.log("Sign of 10:", getSign(10));
console.log("Sign of -5:", getSign(-5));
console.log("Sign of 0:", getSign(0));

// Function with default parameters
function multiply(a, b = 2) {
    return a * b;
}

console.log("multiply(5, 3) =", multiply(5, 3));
console.log("multiply(5) =", multiply(5));

// Recursive function
function factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

console.log("factorial(5) =", factorial(5));

// Arrow functions
let square = x => x * x;
let sumTwo = (a, b) => a + b;

console.log("square(4) =", square(4));
console.log("sumTwo(3, 7) =", sumTwo(3, 7));

console.log("✅ Test 03 Passed: Functions");
